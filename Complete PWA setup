{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:15px}.stat,.panel{background:white;border:1px solid var(--line);border-radius:13px;box-shadow:0 3px 12px #1e2d4405}.stat{padding:15px;min-height:118px}.stat small{font-size:10px;color:#8994a5}.stat strong{display:block;font-size:23px;margin:8px 0 3px}.stat span{font-size:9px;color:#9aa4b1}.grid{display:grid;grid-template-columns:1.45fr 1fr;gap:14px;margin-bottom:14px}.panel{padding:19px}.panelhead{display:flex;align-items:center;justify-content:space-between;margin-bottom:15px}.panel h2{font-size:16px;margin:5px 0}.task{display:flex;gap:10px;align-items:center;padding:12px 0;border-top:1px solid #eff2f6}.check{width:21px;height:21px;border:1px solid #d6deea;background:white;border-radius:7px;color:white}.check.done{background:#7189ae;border-color:#7189ae}.taskinfo{flex:1}.taskinfo b{font-size:11px;display:block}.taskinfo small{font-size:9px;color:#929dad;display:block;margin-top:4px}.finished b{text-decoration:line-through;color:#9ca6b3}.muted{font-size:10px;color:#8994a5}.progress{height:5px;background:#edf0f5;border-radius:9px;overflow:hidden;margin:9px 0 13px}.progress i{height:100%;display:block;background:#8198bd}.coach{background:linear-gradient(145deg,#fff,#f6f8fc)}.orb{width:45px;height:45px;border-radius:14px;background:#e8edf8;color:#60799f;display:grid;place-items:center;font-size:22px;margin:15px 0}.coach h3{font-size:14px}.coach p,.copy{font-size:10px;color:#7d899a;line-height:1.8}.head{margin:4px 0 22px}.head h1{font-size:27px}.row{display:flex;gap:8px;align-items:center;flex-wrap:wrap}.filters{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:12px}.filter{border:1px solid var(--line);background:white;color:#7d899a;border-radius:18px;padding:7px 12px;font-size:10px}.filter.on{background:#19263c;color:white}.field{display:grid;gap:6px;margin:12px 0;font-size:10px;color:#68778d}.field input,.field select,.field textarea{border:1px solid #e3e8ef;border-radius:8px;padding:10px;font-size:11px;width:100%;background:white}.field textarea{min-height:90px}.notice{background:#f4f6fa;padding:13px;border-radius:9px;color:#78869b;font-size:10px;line-height:1.8}.card{border:1px solid #edf0f4;border-radius:10px;padding:13px;margin:9px 0}.card b{font-size:11px}.card p{font-size:10px;color:#8591a2;line-height:1.7}.small{border:0;background:#eff2f7;border-radius:7px;padding:7px 10px;font-size:9px;color:#536782}.bars{display:grid;grid-template-columns:70px 1fr 35px;gap:9px;align-items:center;margin:14px 0;font-size:10px}.bar{height:7px;background:#edf1f6;border-radius:8px;overflow:hidden}.bar i{display:block;height:100%;background:#8ba0c3}.twocol{display:grid;grid-template-columns:1fr 1fr;gap:10px}.footer{border-top:1px solid var(--line);margin-top:26px;padding:16px 0;font-size:9px;color:#9aa4b1}.modalbg{position:fixed;inset:0;background:#10182788;display:grid;place-items:center;padding:15px;z-index:10}.modal{background:white;border-radius:15px;padding:22px;width:min(480px,100%);max-height:90vh;overflow:auto}.modalhead{display:flex;justify-content:space-between;align-items:center}.modal h2{font-size:18px}.modalactions{display:flex;justify-content:flex-end;gap:8px;margin-top:16px}.toast{position:fixed;bottom:20px;left:50%;transform:translateX(-50%);background:#19263c;color:white;padding:12px 17px;border-radius:9px;font-size:11px;z-index:20}.mobilebrand{display:none}

<main><header class="top"><div class="top-left"><button class="topbtn" onclick="backPage()" aria-label="뒤로 가기">← <span>뒤로</span></button><div class="mobilebrand">◈ TRAINEE LAB</div><div class="crumb">Workspace　/　<span id="crumb">개요</span></div></div><div class="top-right"><button class="topbtn editlink" onclick="go('제작자 편집')">⚙ <span>제작자 편집</span></button><b>STANDALONE DEMO</b></div></header><div class="content" id="view"></div></main><nav class="mobilebar" id="mobilebar"><button onclick="go('개요')">⌂<small>홈</small></button><button onclick="go('일일 훈련')">▦<small>훈련</small></button><button onclick="go('성장 분석')">▥<small>성장</small></button><button onclick="go('오디션 관리')">◎<small>오디션</small></button><button onclick="openMenu()">☰<small>전체 메뉴</small></button></nav><div id="modal"></div><div id="toast"></div>
<script>
const KEY='trainee_lab_standalone_2026';
const defaults={profile:{name:'Rookie',age:'13–15세',agency:'SM',position:'올라운더',focus:'댄스',minutes:60},tasks:[{id:1,title:'호흡 안정화 & 립트릴',cat:'보컬',mins:12,done:false,detail:'편안한 호흡으로 짧게 진행하세요.'},{id:2,title:'리듬 아이솔레이션',cat:'댄스',mins:15,done:false,detail:'천천히 움직임을 분리해 연습하세요.'},{id:3,title:'오디션 곡 가사 전달',cat:'보컬',mins:18,done:false,detail:'가사의 의미를 정리하고 전달을 확인하세요.'},{id:4,title:'카메라 퍼포먼스 체크',cat:'퍼포먼스',mins:10,done:false,detail:'시선과 표현을 직접 기록해 확인하세요.'},{id:5,title:'회복 스트레칭',cat:'루틴',mins:5,done:false,detail:'통증 없는 범위에서 가볍게 움직이세요.'}],journal:'',auditions:[],library:[{title:'호흡 기초 루틴',cat:'보컬',mins:10,desc:'호흡과 발성 준비'},{title:'리듬 아이솔레이션',cat:'댄스',mins:15,desc:'움직임을 분리해 리듬 감각 기르기'}],evaluations:[],posts:[]};
let db;try{db={...structuredClone(defaults),...JSON.parse(localStorage.getItem(KEY)||'{}')}}catch{db=structuredClone(defaults)}
let page='개요',filter='전체',pageStack=[];
function backPage(){if(pageStack.length){page=pageStack.pop();render()}else{page='개요';render()}}
function openMenu(){show('전체 메뉴',`<div class="twocol">${pages.map(p=>`<button class="btn secondary" style="margin:3px 0" onclick="close();go('${p}')">${p}</button>`).join('')}</div>`,'close()')}

const pages=['개요','AI 매니저','일일 훈련','보컬 트레이닝','댄스 트레이닝','랩 & 퍼포먼스','월간 평가','성장 분석','오디션 관리','트레이닝 라이브러리','건강 루틴','커뮤니티','멤버십','마이페이지','제작자 편집'];
function save(){localStorage.setItem(KEY,JSON.stringify(db))}
function esc(x){return String(x??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function msg(s){document.getElementById('toast').innerHTML='<div class="toast">'+esc(s)+'</div>';setTimeout(()=>document.getElementById('toast').innerHTML='',2200)}
function go(p){if(p===page)return;pageStack.push(page);if(pageStack.length>30)pageStack.shift();page=p;render()}
function taskRows(a){return a.map(t=>`<div class="task ${t.done?'finished':''}"><button class="check ${t.done?'done':''}" onclick="toggle(${t.id})">${t.done?'✓':''}</button><div class="taskinfo"><b>${esc(t.title)}</b><small>${esc(t.cat)} · ${t.mins}분 · ${esc(t.detail)}</small></div><span class="muted">${t.done?'완료':'예정'}</span></div>`).join('')||'<div class="notice">표시할 항목이 없습니다.</div>'}
function header(t,d){return `<div class="head"><div class="eyebrow">TRAINEE LAB / ${page.toUpperCase()}</div><h1>${t}</h1><p>${d}</p></div>`}
function ph(k,t,r=''){return `<div class="panelhead"><div><div class="eyebrow">${k}</div><h2>${t}</h2></div>${r}</div>`}
function render(){document.getElementById('nav').innerHTML=pages.map((p,i)=>`<button class="${page===p?'active':''}" onclick="go('${p}')">${['⌂','✧','▦','♫','◈','▤','★','▥','◎','▣','♡','☷','♢','○','⚙'][i]}　${p}</button>`).join('');document.getElementById('crumb').textContent=page;
let done=db.tasks.filter(t=>t.done).length,mins=db.tasks.filter(t=>t.done).reduce((a,t)=>a+t.mins,0),pct=db.tasks.length?Math.round(done/db.tasks.length*100):0,v='';
if(page==='개요')v=`<div class="welcome"><div><div class="eyebrow">YOUR TRAINING OVERVIEW</div><h1>${esc(db.profile.name)}님의 트레이닝 룸</h1><p>작은 훈련의 반복이 무대를 만듭니다. 오늘의 계획을 확인하세요.</p></div><button class="btn primary" onclick="go('일일 훈련')">▶ 훈련 시작하기</button></div><div class="stats"><div class="stat"><small>완료 훈련 시간</small><strong>${mins}분</strong><span>완료 처리한 기록 기준</span></div><div class="stat"><small>오늘의 달성률</small><strong>${pct}%</strong><span>${done}/${db.tasks.length}개 완료</span></div><div class="stat"><small>등록 오디션</small><strong>${db.auditions.length}</strong><span>직접 입력한 일정</span></div><div class="stat"><small>저장 콘텐츠</small><strong>${db.library.length}</strong><span>개인 라이브러리</span></div></div><div class="grid"><section class="panel">${ph('DAILY TRAINING','오늘의 훈련',`<button class="small" onclick="go('일일 훈련')">전체 보기 →</button>`)}<div class="muted">진행률 ${done}/${db.tasks.length}</div><div class="progress"><i style="width:${pct}%"></i></div>${taskRows(db.tasks.slice(0,4))}</section><section class="panel coach">${ph('AI PERSONAL MANAGER','오늘의 코칭','<span class="eyebrow">RULE DEMO</span>')}<div class="orb">✧</div><h3>${esc(db.profile.focus)} 분야에 우선순위를 두세요.</h3><p class="copy">프로필상 집중 분야는 ${esc(db.profile.focus)}, 하루 가능 시간은 ${db.profile.minutes}분입니다. 이 정보로 훈련 배분 예시를 제공합니다. 실제 AI 분석이나 음성·영상 측정은 하지 않았습니다.</p><button class="btn secondary" onclick="go('AI 매니저')">코칭 자세히 보기</button></section></div><section class="panel">${ph('YOUR PROFILE','트레이닝 프로필',`<button class="small" onclick="profile()">수정</button>`)}<div class="twocol"><div>목표 기획사　<b>${esc(db.profile.agency)}</b></div><div>포지션　<b>${esc(db.profile.position)}</b></div><div>집중 분야　<b>${esc(db.profile.focus)}</b></div><div>하루 연습 시간　<b>${db.profile.minutes}분</b></div></div></section>`;
else if(page==='AI 매니저')v=header('AI Personal Manager','프로필 기반 규칙형 코칭 데모입니다. 외부 AI API는 연결되지 않았습니다.')+`<div class="grid"><section class="panel">${ph('PROFILE-BASED PLAN','훈련 배분 제안')}<div class="notice"><b>${esc(db.profile.name)}님의 현재 설정</b><br>목표: ${esc(db.profile.position)} · 집중: ${esc(db.profile.focus)} · 하루: ${db.profile.minutes}분<br><br>시작 제안: 집중 분야 약 40%, 다른 역량 유지 40%, 준비와 회복 20%로 나누어 계획할 수 있습니다. 이는 실력 진단이 아닌 일정 예시입니다.</div>${[['집중 분야',.4],['다른 역량',.4],['준비·휴식',.2]].map(x=>`<div class="bars"><span>${x[0]}</span><div class="bar"><i style="width:${x[1]*100}%"></i></div><b>${Math.round(db.profile.minutes*x[1])}분</b></div>`).join('')}</section><section class="panel">${ph('PLAN SETTINGS','계획 기준')}<p class="copy">프로필 설정에 따라 계획 예시가 바뀝니다. 통증이나 쉰 목소리가 있으면 훈련보다 휴식을 우선하세요.</p><button class="btn secondary" onclick="profile()">프로필 수정</button></section></div>`;
else if(['일일 훈련','보컬 트레이닝','댄스 트레이닝','랩 & 퍼포먼스'].includes(page)){let cat=page==='보컬 트레이닝'?'보컬':page==='댄스 트레이닝'?'댄스':page==='랩 & 퍼포먼스'?'other':'all';let list=db.tasks.filter(t=>(cat==='all'||(cat==='other'?['랩','퍼포먼스'].includes(t.cat):t.cat===cat))&&(filter==='전체'||t.cat===filter));v=header(page==='일일 훈련'?'오늘의 훈련 계획':page,'완료 기록은 현재 브라우저에 자동 저장됩니다.')+`<section class="panel">${ph('TRAINING CHECKLIST','훈련 목록',`<button class="btn primary" onclick="addTask()">＋ 훈련 추가</button>`)}<div class="filters">${['전체','보컬','댄스','랩','퍼포먼스','루틴'].map(x=>`<button class="filter ${filter===x?'on':''}" onclick="filter='${x}';render()">${x}</button>`).join('')}</div>${taskRows(list)}</section><section class="panel" style="margin-top:14px">${ph('TRAINING JOURNAL','연습 일지')}<label class="field"><textarea id="journal" placeholder="오늘 느낀 점과 다음에 확인할 부분을 기록하세요.">${esc(db.journal)}</textarea></label><button class="btn secondary" onclick="saveJournal()">일지 저장</button></section>`}
else if(page==='성장 분석')v=header('Progress Analytics','저장된 훈련 완료 데이터만 집계합니다. 실력 향상 점수는 임의로 생성하지 않습니다.')+`<div class="stats"><div class="stat"><small>완료 시간</small><strong>${mins}분</strong></div><div class="stat"><small>완료 훈련</small><strong>${done}개</strong></div><div class="stat"><small>완료율</small><strong>${pct}%</strong></div><div class="stat"><small>자기평가 기록</small><strong>${db.evaluations.length}개</strong></div></div><section class="panel">${ph('BY CATEGORY','분야별 완료')} ${['보컬','댄스','랩','퍼포먼스','루틴'].map(c=>{let a=db.tasks.filter(t=>t.cat===c),d=a.filter(t=>t.done).length;return `<div class="bars"><span>${c}</span><div class="bar"><i style="width:${a.length?d/a.length*100:0}%"></i></div><b>${d}/${a.length}</b></div>`}).join('')}</section>`;
else if(page==='오디션 관리')v=header('Audition Manager','공식 일정은 해당 기획사의 공식 채널에서 확인하고, 준비 기록을 관리하세요.')+`<section class="panel">${ph('MY AUDITIONS','오디션 일정',`<button class="btn primary" onclick="audition()">＋ 일정 추가</button>`)}${db.auditions.map((a,i)=>`<div class="card"><div class="row" style="justify-content:space-between"><b>${esc(a.agency)} · ${esc(a.title)}</b><button class="small" onclick="remove('auditions',${i})">삭제</button></div><p>${esc(a.date)} · ${esc(a.status)}<br>${esc(a.memo)}</p></div>`).join('')||'<div class="notice">등록된 오디션이 없습니다.</div>'}</section>`;
else if(page==='트레이닝 라이브러리')v=header('Training Library','훈련 콘텐츠를 직접 추가하고 오늘의 훈련 목록에 활용하세요.')+`<section class="panel">${ph('LEARNING CONTENT','훈련 콘텐츠',`<button class="btn primary" onclick="libraryAdd()">＋ 콘텐츠 추가</button>`)}${db.library.map((x,i)=>`<div class="card"><div class="row" style="justify-content:space-between"><b>${esc(x.title)}</b><span class="muted">${esc(x.cat)} · ${x.mins}분</span></div><p>${esc(x.desc)}</p><button class="small" onclick="useLib(${i})">오늘 훈련에 추가</button> <button class="small" onclick="remove('library',${i})">삭제</button></div>`).join('')}</section>`;
else if(page==='월간 평가')v=header('Monthly Self Review','자기평가 기록입니다. 전문가가 평가한 결과로 표시하지 않습니다.')+`<section class="panel">${ph('MONTHLY REVIEW','월간 자기평가',`<button class="btn primary" onclick="evaluation()">＋ 평가 기록</button>`)}${db.evaluations.map((e,i)=>`<div class="card"><div class="row" style="justify-content:space-between"><b>${esc(e.month)} 자기평가</b><button class="small" onclick="remove('evaluations',${i})">삭제</button></div><p>보컬 ${esc(e.v)} · 댄스 ${esc(e.d)} · 랩 ${esc(e.r)} · 퍼포먼스 ${esc(e.p)}<br>잘한 점: ${esc(e.good)}<br>다음 목표: ${esc(e.next)}</p><span class="eyebrow">SELF REVIEW · NOT EXPERT EVALUATION</span></div>`).join('')||'<div class="notice">아직 평가 기록이 없습니다.</div>'}</section>`;
else if(page==='건강 루틴')v=header('Healthy Routine','무리한 연습보다 회복과 지속 가능성을 우선합니다.')+`<div class="grid"><section class="panel">${ph('BEFORE TRAINING','연습 전 준비')}<div class="notice">가벼운 준비 운동을 하고 목과 몸 상태를 확인하세요. 물을 가까이 두고 통증, 어지러움, 쉰 목소리가 있으면 중단하고 쉬세요.</div></section><section class="panel">${ph('RECOVERY','회복 원칙')}<div class="notice">충분한 수면과 규칙적인 식사를 유지하세요. 컨디션이 좋지 않은 날은 훈련량을 줄이세요. 체중이나 외모를 훈련 성과로 평가하지 않습니다.</div></section></div>`;
else if(page==='커뮤니티')v=header('Community','현재 게시글은 이 브라우저에만 저장되는 데모입니다. 실제 공개 게시판은 아닙니다.')+`<section class="panel">${ph('COMMUNITY BOARD','연습 이야기',`<button class="btn primary" onclick="postAdd()">＋ 글 작성</button>`)}<div class="notice">주소, 학교, 전화번호, 실시간 위치 등 민감한 정보를 공유하지 마세요. 낯선 사람의 개인 연락이나 외부 만남 요구에는 응하지 말고 보호자 등 신뢰할 수 있는 어른에게 알리세요.</div>${db.posts.map((p,i)=>`<div class="card"><b>${esc(p.title)}</b><p>${esc(p.body)}</p><button class="small" onclick="remove('posts',${i})">삭제</button></div>`).join('')}</section>`;
else if(page==='멤버십')v=header('Membership','요금제 설명용 데모입니다. 결제와 구독은 발생하지 않습니다.')+`<div class="grid">${[['FREE','기본 훈련 계획','기본 기록과 콘텐츠'],['PRO','개인화 훈련 관리','상세 계획과 성장 분석'],['PREMIUM','전문가 피드백','실제 전문가 연결은 추후 개발']].map(x=>`<section class="panel"><div class="eyebrow">PLAN</div><h2>${x[0]}</h2><p class="copy">${x[1]}<br>${x[2]}</p><button class="btn secondary" onclick="msg('데모: 실제 결제는 연결되지 않았습니다.')">플랜 선택 · DEMO</button></section>`).join('')}</div>`;
else if(page==='마이페이지')v=header('My Profile','프로필과 로컬 데이터를 관리합니다.')+`<section class="panel">${ph('PERSONAL PROFILE','내 정보',`<button class="btn primary" onclick="profile()">프로필 수정</button>`)}<div class="twocol"><div>닉네임　<b>${esc(db.profile.name)}</b></div><div>연령대　<b>${esc(db.profile.age)}</b></div><div>기획사　<b>${esc(db.profile.agency)}</b></div><div>포지션　<b>${esc(db.profile.position)}</b></div></div><hr style="border:0;border-top:1px solid #edf0f4;margin:20px 0"><div class="row"><button class="btn secondary" onclick="backup()">데이터 백업</button><label class="btn secondary">백업 불러오기<input hidden type="file" accept="application/json" onchange="restore(event)"></label><button class="btn secondary" onclick="reset()">초기화</button></div></section>`;
else v=header('Creator Workspace','앱 콘텐츠를 직접 추가·수정·삭제하는 공간입니다.')+`<div class="notice"><b>주의:</b> 현재는 브라우저 로컬 편집 데모입니다. 이 페이지는 비밀번호로 보호되지 않으며, 편집 내용은 현재 기기의 브라우저에만 저장됩니다. 공개 서비스의 관리자 권한은 서버에서 별도로 구현해야 합니다.</div><section class="panel" style="margin-top:14px">${ph('QUICK ACTIONS','운영 도구')}<div class="row"><button class="btn primary" onclick="addTask()">＋ 훈련 항목 추가</button><button class="btn secondary" onclick="libraryAdd()">＋ 라이브러리 콘텐츠 추가</button><button class="btn secondary" onclick="profile()">프로필 기본값 수정</button></div><div class="row" style="margin-top:10px"><button class="btn secondary" onclick="backup()">전체 데이터 내보내기</button><label class="btn secondary">백업 가져오기<input hidden type="file" accept="application/json" onchange="restore(event)"></label></div></section><section class="panel creator-list">${ph('TRAINING TASKS','훈련 항목 편집')} ${db.tasks.map((t,i)=>`<div class="creator-item"><div><b>${esc(t.title)}</b><div class="muted">${esc(t.cat)} · ${t.mins}분</div></div><div class="creator-actions"><button class="small" onclick="editTask(${i})">수정</button><button class="small" onclick="remove('tasks',${i})">삭제</button></div></div>`).join('')||'<div class="notice">훈련 항목이 없습니다.</div>'}</section><section class="panel creator-list">${ph('LIBRARY CONTENT','라이브러리 편집')} ${db.library.map((x,i)=>`<div class="creator-item"><div><b>${esc(x.title)}</b><div class="muted">${esc(x.cat)} · ${x.mins}분</div></div><div class="creator-actions"><button class="small" onclick="editLibrary(${i})">수정</button><button class="small" onclick="remove('library',${i})">삭제</button></div></div>`).join('')||'<div class="notice">콘텐츠가 없습니다.</div>'}</section>`;
document.getElementById('view').innerHTML=v+`<div class="footer">© 2026 TRAINEE LAB · YOUR ROOM, YOUR STAGE.　LOCAL DATA ONLY</div>`}
function toggle(id){let t=db.tasks.find(x=>x.id===id);if(t)t.done=!t.done;save();render()}
function profile(){let p=db.profile;show('프로필 수정',`<label class="field">닉네임<input id="pn" value="${esc(p.name)}"></label><div class="twocol"><label class="field">연령대<select id="pa">${['13세 미만','13–15세','16–18세','19세 이상'].map(x=>`<option ${x===p.age?'selected':''}>${x}</option>`)}</select></label><label class="field">목표 기획사<select id="pag">${['SM','JYP','YG','HYBE','Starship','Cube','High Up','기타'].map(x=>`<option ${x===p.agency?'selected':''}>${x}</option>`)}</select></label></div><div class="twocol"><label class="field">목표 포지션<select id="pp">${['보컬','메인댄서','래퍼','올라운더','퍼포먼스 중심','아직 미정'].map(x=>`<option ${x===p.position?'selected':''}>${x}</option>`)}</select></label><label class="field">집중 분야<select id="pf">${['보컬','댄스','랩','퍼포먼스'].map(x=>`<option ${x===p.focus?'selected':''}>${x}</option>`)}</select></label></div><label class="field">하루 연습 가능 시간<input id="pm" type="range" min="15" max="180" step="15" value="${p.minutes}" oninput="document.getElementById('pml').textContent=this.value+'분'"><span id="pml">${p.minutes}분</span></label>`,'saveProfile()')}
function saveProfile(){db.profile={...db.profile,name:document.getElementById('pn').value||'Rookie',age:document.getElementById('pa').value,agency:document.getElementById('pag').value,position:document.getElementById('pp').value,focus:document.getElementById('pf').value,minutes:+document.getElementById('pm').value};save();close();render()}
function show(title,body,fn){document.getElementById('modal').innerHTML=`<div class="modalbg" onclick="if(event.target===this)close()"><div class="modal"><div class="modalhead"><h2>${title}</h2><button class="btn secondary" onclick="close()">✕</button></div>${body}<div class="modalactions"><button class="btn secondary" onclick="close()">취소</button><button class="btn primary" onclick="${fn}">저장</button></div></div></div>`}
function close(){document.getElementById('modal').innerHTML=''}
function addTask(){show('훈련 항목 추가',`<label class="field">훈련 이름<input id="tn"></label><div class="twocol"><label class="field">분야<select id="tc">${['보컬','댄스','랩','퍼포먼스','루틴'].map(x=>`<option>${x}</option>`)}</select></label><label class="field">시간(분)<input id="tm" type="number" value="10" min="1"></label></div><label class="field">연습 방법<textarea id="td"></textarea></label>`,'saveTask()')}
function saveTask(){let title=document.getElementById('tn').value.trim();if(!title)return msg('훈련 이름을 입력하세요.');db.tasks.push({id:Date.now(),title,cat:document.getElementById('tc').value,mins:+document.getElementById('tm').value||10,done:false,detail:document.getElementById('td').value});save();close();render()}
function editTask(i){let t=db.tasks[i];show('훈련 항목 수정',`<label class="field">훈련 이름<input id="etn" value="${esc(t.title)}"></label><div class="twocol"><label class="field">분야<select id="etc">${['보컬','댄스','랩','퍼포먼스','루틴'].map(x=>`<option ${x===t.cat?'selected':''}>${x}</option>`)}</select></label><label class="field">시간(분)<input id="etm" type="number" min="1" value="${t.mins}"></label></div><label class="field">연습 방법<textarea id="etd">${esc(t.detail)}</textarea></label>` ,`saveEditedTask(${i})`)}
function saveEditedTask(i){let t=db.tasks[i];t.title=document.getElementById('etn').value.trim()||t.title;t.cat=document.getElementById('etc').value;t.mins=Math.max(1,+document.getElementById('etm').value||t.mins);t.detail=document.getElementById('etd').value;save();close();render();msg('훈련 항목을 수정했습니다.')}
function editLibrary(i){let x=db.library[i];show('라이브러리 콘텐츠 수정',`<label class="field">제목<input id="elt" value="${esc(x.title)}"></label><div class="twocol"><label class="field">분야<select id="elc">${['보컬','댄스','랩','퍼포먼스','오디션 준비'].map(c=>`<option ${c===x.cat?'selected':''}>${c}</option>`)}</select></label><label class="field">시간(분)<input id="elm" type="number" min="1" value="${x.mins}"></label></div><label class="field">설명<textarea id="eld">${esc(x.desc)}</textarea></label>`,`saveEditedLibrary(${i})`)}
function saveEditedLibrary(i){let x=db.library[i];x.title=document.getElementById('elt').value.trim()||x.title;x.cat=document.getElementById('elc').value;x.mins=Math.max(1,+document.getElementById('elm').value||x.mins);x.desc=document.getElementById('eld').value;save();close();render();msg('라이브러리 콘텐츠를 수정했습니다.')}
function saveJournal(){db.journal=document.getElementById('journal').value;save();msg('연습 일지를 저장했습니다.')}
function audition(){show('오디션 일정 추가',`<label class="field">기획사<input id="ag"></label><label class="field">오디션명<input id="at"></label><div class="twocol"><label class="field">날짜<input id="ad" type="date"></label><label class="field">상태<select id="as"><option>준비 중</option><option>지원 완료</option><option>결과 대기</option><option>종료</option></select></label></div><label class="field">메모<textarea id="am"></textarea></label>`,'saveAudition()')}
function saveAudition(){db.auditions.push({agency:document.getElementById('ag').value,title:document.getElementById('at').value,date:document.getElementById('ad').value,status:document.getElementById('as').value,memo:document.getElementById('am').value});save();close();render()}
function libraryAdd(){show('훈련 콘텐츠 등록',`<label class="field">제목<input id="lt"></label><div class="twocol"><label class="field">분야<select id="lc">${['보컬','댄스','랩','퍼포먼스','오디션 준비'].map(x=>`<option>${x}</option>`)}</select></label><label class="field">시간(분)<input id="lm" type="number" value="10"></label></div><label class="field">설명<textarea id="ld"></textarea></label>`,'saveLibrary()')}
function saveLibrary(){db.library.push({title:document.getElementById('lt').value,cat:document.getElementById('lc').value,mins:+document.getElementById('lm').value||10,desc:document.getElementById('ld').value});save();close();render()}
function useLib(i){let x=db.library[i];db.tasks.push({id:Date.now(),title:x.title,cat:x.cat,mins:x.mins,done:false,detail:x.desc});save();render();msg('오늘 훈련에 추가했습니다.')}
function evaluation(){show('월간 자기평가',`<label class="field">평가 월<input id="em" type="month" value="${new Date().toISOString().slice(0,7)}"></label><div class="twocol">${['보컬','댄스','랩','퍼포먼스'].map((x,i)=>`<label class="field">${x}<select id="e${i}"><option>기록 없음</option><option>개선 필요</option><option>보통</option><option>만족</option></select></label>`)}</div><label class="field">잘한 점<textarea id="eg"></textarea></label><label class="field">다음 목표<textarea id="en"></textarea></label>`,'saveEvaluation()')}
function saveEvaluation(){db.evaluations.push({month:document.getElementById('em').value,v:document.getElementById('e0').value,d:document.getElementById('e1').value,r:document.getElementById('e2').value,p:document.getElementById('e3').value,good:document.getElementById('eg').value,next:document.getElementById('en').value});save();close();render()}
function postAdd(){show('게시글 작성',`<label class="field">제목<input id="pt"></label><label class="field">내용<textarea id="pb"></textarea></label><div class="notice">개인 연락처, 주소, 학교, 위치를 게시하지 마세요.</div>`,'savePost()')}
function savePost(){db.posts.unshift({title:document.getElementById('pt').value,body:document.getElementById('pb').value});save();close();render()}
function remove(k,i){if(confirm('삭제할까요?')){db[k].splice(i,1);save();render()}}
function backup(){let a=document.createElement('a'),u=URL.createObjectURL(new Blob([JSON.stringify(db,null,2)],{type:'application/json'}));a.href=u;a.download='trainee-lab-backup.json';a.click();URL.revokeObjectURL(u)}
function restore(e){let f=e.target.files[0];if(!f)return;let r=new FileReader();r.onload=()=>{try{let x=JSON.parse(r.result);if(!x.profile||!Array.isArray(x.tasks))throw 0;db={...structuredClone(defaults),...x};save();render();msg('백업을 불러왔습니다.')}catch{msg('올바른 백업 파일이 아닙니다.')}};r.readAsText(f)}
function reset(){if(confirm('저장 데이터를 모두 초기화할까요?')){db=structuredClone(defaults);save();render()}}
render();
</script><script>
if ("serviceWorker" in navigator) {
  window.addEventListener("load", () => {
    navigator.serviceWorker.register("./service-worker.js")
      .catch(error => console.error("SW registration failed:", error));
  });
}
</script></body></html>
